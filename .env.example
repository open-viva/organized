# Gemini API key for AI-powered schedule generation (recommended model: gemini-2.5-flash)
# Set this in Vercel Project Settings -> Environment Variables
GEMINI_API_KEY=your-gemini-api-key

# Optional: Notion Integration (for exporting to Notion)
# Create an integration at https://www.notion.so/my-integrations
# NOTION_INTEGRATION_TOKEN=secret_...

# =============================================================================
# Backend Configuration (open-viva/api)
# =============================================================================
# URL of your open-viva/api instance
# This is used client-side, so it must be exposed as NEXT_PUBLIC_*
# See: https://github.com/open-viva/api
NEXT_PUBLIC_OPENVIVA_API_URL=http://localhost:3000

# Optional: API key for the backend (if configured on your open-viva/api instance)
# BACKEND_API_KEY=your-api-key-here
