# OpenAI API key for AI-powered schedule generation
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Notion Integration (for exporting to Notion)
# Create an integration at https://www.notion.so/my-integrations
# NOTION_INTEGRATION_TOKEN=secret_...

# =============================================================================
# Backend Configuration (chemediaho)
# =============================================================================
# URL of the local chemediaho backend server
# The backend handles ClasseViva API calls from a residential IP to bypass WAF
# See: https://github.com/gablilli/chemediaho
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Optional: API key for the backend (if configured)
# BACKEND_API_KEY=your-api-key-here
